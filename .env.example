# Deployment signing key — NEVER commit real value
PRIVATE_KEY=

# Vow constructor failure sink address — nonzero, immutable after deploy.
# REQUIRED. No fallback: a wrong value is permanently baked into the contract.
# Use the sink for the chain you are deploying to:
#   968 (Bohr Testnet) → 0xF4436Ae58d3Cc4F35dc5D38F56DBBa959230285B
#   677 (BOT Mainnet)  → <mainnet sink — must be set before deploying>
FAILURE_SINK=

# Chain ID is NOT an env var: the deploy script reads block.chainid and the RPC
# comes from a Foundry profile. Guard accepts 968 and 677 only.
# Foundry profiles (used via FOUNDRY_PROFILE or --profile flag):
#   bohr_testnet  → chain 968  → https://rpc.bohr.life
#   bot_mainnet   → chain 677  → https://rpc.botchain.ai
