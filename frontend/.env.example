# Public site origin. Used for metadataBase, og:url, og:image, robots.txt and
# sitemap.xml. Must be an absolute URL (scheme + host); a malformed value fails
# the build. Leave unset to use the production domain fallback.
NEXT_PUBLIC_SITE_URL=https://vowprotocol.web.id

# IPFS gateway used to resolve on-chain `ipfs://` proof URIs into clickable
# links. Trailing slash optional. Leave unset for the public ipfs.io fallback.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ---------------------------------------------------------------------------
# Chain target. All three values are public (they ship in the client bundle);
# only signing keys are secret. NEXT_PUBLIC_* is inlined at build time, so they
# must be set before `next build`, not at runtime.
#
# Submission target is BOT Chain Mainnet (chain 677): frontend/.env.production
# commits the trio below for every production build, so a plain `npm run build`
# targets mainnet. These values are the documented reference for the same target.
NEXT_PUBLIC_VOW_CHAIN=mainnet
NEXT_PUBLIC_VOW_ADDRESS=0x04e6db5BE9861fbEd3E7a4192A3444a7D0e07cb4
NEXT_PUBLIC_FAILURE_SINK=0x8d9165F2eDF3Ec10659A0762112DE9e007619aE7

# All three must be set together. NEXT_PUBLIC_VOW_CHAIN=mainnet alone is inert:
# lib/contract.ts falls back to testnet when NEXT_PUBLIC_VOW_ADDRESS is absent,
# so a mainnet UI can never point at the testnet contract.
#
# For a Bohr testnet build (local dev reads .env.development; the recorded Gate T
# evidence also ran here), override with the testnet trio instead:
#
#   NEXT_PUBLIC_VOW_CHAIN=testnet
#   NEXT_PUBLIC_VOW_ADDRESS=0x9539263f4861812B08C37Bb3cB6603c771d6530b
#   NEXT_PUBLIC_FAILURE_SINK=0xF4436Ae58d3Cc4F35dc5D38F56DBBa959230285B
