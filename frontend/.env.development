# Local development target: Bohr Testnet (chain 968).
#
# `next dev` loads this file, so `npm run dev` stays on testnet and a dev wallet
# cannot accidentally lock real BOT. Production builds ignore this file and read
# .env.production (mainnet). `.env*` is gitignored except .env.example, so this
# file stays local — it is documented in .env.example and SUBMISSION_CHECKLIST.md.
NEXT_PUBLIC_VOW_CHAIN=testnet
NEXT_PUBLIC_VOW_ADDRESS=0x9539263f4861812B08C37Bb3cB6603c771d6530b
NEXT_PUBLIC_FAILURE_SINK=0xF4436Ae58d3Cc4F35dc5D38F56DBBa959230285B
