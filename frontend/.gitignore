# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ponytail: .env* swallows the template too; re-include it so the documented
# site origin is actually visible to git (root .gitignore already does this).
!.env.example
# The mainnet build target must exist on the build machine without a manual
# setup step, so it is committed. It holds public values only (they ship in the
# client bundle). .env.development is committed for the same reason: it pins
# `next dev` to testnet on every machine, so no local wallet can lock real BOT.
!.env.production
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
